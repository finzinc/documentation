          "401": {
            "description": "Unauthorized \u2014 invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "ok": false,
                      "error": {
                        "type": "authorization",
                        "message": "Token not found",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
