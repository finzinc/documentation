{
  "openapi": "3.0.3",
  "info": {
    "title": "FinZinc API",
    "description": "FinZinc Payment Processing API for deposit and withdrawal operations",
    "version": "1.0.0",
    "contact": {
      "name": "FinZinc Support",
      "url": "https://finzinc.net"
    }
  },
  "servers": [
    {
      "url": "https://api.finzinc.net",
      "description": "Production environment"
    },
    {
      "url": "https://api-test.finzinc.net",
      "description": "Test environment"
    }
  ],
  "paths": {
    "/v1/payments/{id}/check": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Get Payment Status",
        "description": "Retrieve the current status of a payment by its internal ID or merchant external_id.\n\nAlways check `status` field. Terminal statuses: `success`, `success_partial`, `success_adjusted`, `failed`.\n\nStatus mapping:\n- `COMPLETED` \u2192 `success`\n- `PARTIALLY_COMPLETED` \u2192 `success_partial`\n- `ADJUSTING_UP` / `ADJUSTING_DOWN` confirmed \u2192 `success_adjusted`\n- `FAILED` / `EXPIRED` / `CANCELED` \u2192 `failed`\n- In-progress states \u2192 `pending` or `processing`",
        "operationId": "getPaymentStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Payment ID (transaction_id) or merchant external_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "txn_fin_123456"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                },
                "examples": {
                  "Success": {
                    "summary": "Completed deposit",
                    "value": {
                      "transaction_id": "txn_fin_123456",
                      "external_id": "ext_20260331_001",
                      "status": "success",
                      "operation": "deposit",
                      "sum": "100.00",
                      "currency_code": "INR",
                      "created_at": "2026-03-31T23:48:00Z",
                      "updated_at": "2026-03-31T23:51:00Z"
                    }
                  },
                  "SuccessPartial": {
                    "summary": "Partially completed (underpaid)",
                    "value": {
                      "transaction_id": "txn_fin_123457",
                      "external_id": "ext_20260331_007",
                      "status": "success_partial",
                      "operation": "deposit",
                      "sum": "100.00",
                      "sum_processed": "80.00",
                      "currency_code": "INR",
                      "created_at": "2026-03-31T23:48:00Z",
                      "updated_at": "2026-03-31T23:52:00Z"
                    }
                  },
                  "SuccessAdjusted": {
                    "summary": "Amount was adjusted (up or down)",
                    "value": {
                      "transaction_id": "txn_fin_123458",
                      "external_id": "ext_20260331_008",
                      "status": "success_adjusted",
                      "operation": "deposit",
                      "sum": "100.00",
                      "sum_processed": "150.00",
                      "correction": "up",
                      "currency_code": "INR",
                      "created_at": "2026-03-31T23:48:00Z",
                      "updated_at": "2026-03-31T23:54:00Z"
                    }
                  },
                  "Pending": {
                    "summary": "Payment still in progress",
                    "value": {
                      "transaction_id": "txn_fin_123459",
                      "external_id": "ext_20260331_009",
                      "status": "pending",
                      "operation": "deposit",
                      "sum": "200.00",
                      "currency_code": "INR",
                      "created_at": "2026-03-31T23:48:00Z",
                      "updated_at": "2026-03-31T23:48:00Z"
                    }
                  },
                  "Error": {
                    "summary": "Payment in error state",
                    "value": {
                      "operation_id": "019d861d-ffd1-7b37-89d6-6fda2e9825eb",
                      "channel": "UPI",
                      "redirect_url": "https://paytopay3.pserv-iner.in/example",
                      "external_id": "ext_20260331_005",
                      "result": "error",
                      "client_amount": null,
                      "rejection_cause": null,
                      "requested_sum": "300.00",
                      "currency_code": "INR",
                      "opened_at": "2026-04-13T09:13:26.228Z",
                      "settled_at": null,
                      "transfer_details": null,
                      "valid_until": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "ok": false,
                      "error": {
                        "type": "authorization",
                        "message": "Token not found",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFound": {
                    "value": {
                      "error": "NOT_FOUND",
                      "message": "Payment with id (txn_fin_123456) not found",
                      "timestamp": "2026-03-31T23:48:00Z"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/payments/{id}/upload_receipt": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Upload UTR / Payment Receipt (H2H)",
        "description": "In server-to-server (`server_mode: true`) mode, confirm a deposit by submitting the UTR (Unique Transaction Reference) and optionally attaching receipt files.\n\nSend as `multipart/form-data`. The `utr` field is required; up to 3 receipt image files can be attached.\n\nExample (curl):\n```bash\ncurl -X POST \"https://api.finzinc.net/v1/payments/txn_fin_123456/upload_receipt\" \\\n  -H \"Authorization: Bearer <token>\" \\\n  -F \"utr=123456789012\" \\\n  -F \"file=@/path/to/receipt.png\"\n```",
        "operationId": "uploadPaymentReceipt",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Payment ID (transaction_id) returned from /initiate",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "txn_fin_123456"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "utr"
                ],
                "properties": {
                  "utr": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 22,
                    "description": "Unique Transaction Reference number from the bank",
                    "example": "123456789012"
                  },
                  "file": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 3,
                    "description": "Receipt image files (PNG, JPG, PDF). Optional, max 3 files."
                  }
                }
              },
              "encoding": {
                "utr": {
                  "style": "form",
                  "explode": true
                },
                "file": {
                  "style": "form",
                  "explode": true
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad request \u2014 missing or invalid UTR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingUTR": {
                    "value": {
                      "error": "MISSING_FIELD",
                      "message": "utr is required",
                      "timestamp": "2026-03-31T23:48:00Z"
                    }
                  },
                  "InvalidUTR": {
                    "value": {
                      "error": "VALIDATION_ERROR",
                      "message": "utr must be between 10 and 22 characters",
                      "timestamp": "2026-03-31T23:48:00Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "ok": false,
                      "error": {
                        "type": "authorization",
                        "message": "Token not found",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFound": {
                    "value": {
                      "error": "NOT_FOUND",
                      "message": "Payment with id (txn_fin_123456) not found",
                      "timestamp": "2026-03-31T23:48:00Z"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Receipt uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                },
                "examples": {
                  "Success": {
                    "value": {}
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/payments/initiate": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create Payment",
        "description": "Initiate a new payment transaction (deposit or withdrawal)",
        "operationId": "createPayment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreateDTO"
              },
              "examples": {
                "DepositUPI": {
                  "summary": "Deposit via UPI",
                  "value": {
                    "sum": "300.00",
                    "status_url": "https://webhook.site/aa98cd5f-6490-483d-ad75-e909d6e4cea1",
                    "currency_code": "INR",
                    "external_id": "ext_20260331_006",
                    "operation": "deposit",
                    "scheme": "direct",
                    "channel": "upi",
                    "account_id": "merchant_acc_001",
                    "redirect_url": "https://merchant.com/success"
                  }
                },
                "WithdrawalUPI": {
                  "summary": "Withdrawal via UPI",
                  "value": {
                    "sum": "1000.00",
                    "status_url": "https://webhook.site/aa98cd5f-6490-483d-ad75-e909d6e4cea1",
                    "currency_code": "INR",
                    "external_id": "ext_20260331_007",
                    "operation": "withdrawal",
                    "scheme": "direct",
                    "channel": "upi",
                    "account_id": "merchant_acc_001",
                    "redirect_url": "https://merchant.com/success",
                    "withdrawal_details": {
                      "beneficiary_name": "Alice Johnson",
                      "vpa": "alice.johnson@okaxis"
                    }
                  }
                },
                "WithdrawalIMPS": {
                  "summary": "Withdrawal via IMPS",
                  "value": {
                    "sum": "2000.00",
                    "status_url": "https://webhook.site/aa98cd5f-6490-483d-ad75-e909d6e4cea1",
                    "currency_code": "INR",
                    "external_id": "ext_20260331_008",
                    "operation": "withdrawal",
                    "scheme": "direct",
                    "channel": "imps",
                    "account_id": "merchant_acc_001",
                    "redirect_url": "https://merchant.com/success",
                    "withdrawal_details": {
                      "beneficiary_name": "Charlie Brown",
                      "bank_account": "123456789012",
                      "ifsc_code": "HDFC0002060"
                    }
                  }
                },
                "DepositUPI_H2H": {
                  "summary": "Deposit via UPI \u2014 H2H (server_mode)",
                  "description": "Use server_mode: true to receive payment credentials directly (transfer_details) instead of a redirect_url. Required for host-to-host integrations.",
                  "value": {
                    "sum": "300.00",
                    "status_url": "https://webhook.site/aa98cd5f-6490-483d-ad75-e909d6e4cea1",
                    "currency_code": "INR",
                    "external_id": "ext_h2h_001",
                    "operation": "deposit",
                    "scheme": "direct",
                    "channel": "upi",
                    "account_id": "merchant_acc_001",
                    "redirect_url": "https://merchant.com/success",
                    "server_mode": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique payment identifier (use for /check and /upload_receipt)",
                      "example": "019d8619-f711-76b7-b0e1-574328b5baf0"
                    },
                    "external_id": {
                      "type": "string",
                      "description": "Merchant-provided external identifier"
                    },
                    "result": {
                      "type": "string",
                      "enum": [
                        "awaiting",
                        "processing",
                        "success",
                        "success_partial",
                        "success_adjusted",
                        "error",
                        "failed"
                      ],
                      "description": "Current payment status"
                    },
                    "channel": {
                      "type": "string",
                      "description": "Payment channel used (uppercased)",
                      "example": "UPI"
                    },
                    "redirect_url": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL to redirect payer to complete payment"
                    },
                    "requested_sum": {
                      "type": "string",
                      "description": "Originally requested amount"
                    },
                    "client_amount": {
                      "type": "string",
                      "nullable": true,
                      "description": "Actual settled amount (null until completed)"
                    },
                    "currency_code": {
                      "type": "string",
                      "description": "Currency code (ISO 4217)"
                    },
                    "rejection_cause": {
                      "type": "string",
                      "nullable": true,
                      "description": "Reason for rejection if failed"
                    },
                    "transfer_details": {
                      "type": "object",
                      "nullable": true,
                      "description": "Payment credentials for H2H mode"
                    },
                    "opened_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Payment creation timestamp"
                    },
                    "settled_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true,
                      "description": "Settlement timestamp (null until completed)"
                    },
                    "valid_until": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true,
                      "description": "Payment expiry timestamp"
                    }
                  },
                  "required": [
                    "operation_id",
                    "external_id",
                    "result",
                    "channel",
                    "requested_sum",
                    "currency_code",
                    "opened_at"
                  ]
                },
                "examples": {
                  "SuccessDeposit": {
                    "summary": "Successful deposit creation",
                    "value": {
                      "operation_id": "019d8619-f711-76b7-b0e1-574328b5baf0",
                      "channel": "UPI",
                      "redirect_url": "https://paytopay3.pserv-iner.in/cmnwz0qij007d7aks6agq30x2?method=upi&prevId=null",
                      "external_id": "ext_20260331_006",
                      "result": "awaiting",
                      "client_amount": null,
                      "rejection_cause": null,
                      "requested_sum": "300.00",
                      "currency_code": "INR",
                      "opened_at": "2026-04-13T09:09:01.845Z",
                      "settled_at": null,
                      "transfer_details": null,
