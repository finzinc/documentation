{
  "openapi": "3.0.3",
  "info": {
    "title": "FinZinc API",
    "description": "FinZinc Payment Processing API for deposit and withdrawal operations",
    "version": "1.0.0",
    "contact": {
      "name": "FinZinc Support",
      "url": "https://finzinc.net"
    }
  },
  "servers": [
    {
      "url": "https://api.finzinc.net",
      "description": "Production environment"
    },
    {
      "url": "https://api-test.finzinc.net",
      "description": "Test environment"
    }
  ],
  "paths": {
    "/v1/payments/{id}/check": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Get Payment Status",
        "description": "Retrieve the current status of a payment by its internal ID or merchant external_id.\n\nAlways check the `result` field:\n- `awaiting` — payment created, waiting for payer action\n- `processing` — payment received, being verified\n- `success` — fully completed, funds settled\n- `success_partial` — partially completed, funds received but less than requested\n- `success_adjusted` — completed with amount correction (up or down)\n- `error` — payment encountered an error\n- `failed` — payment failed, expired, or cancelled",
        "operationId": "getPaymentStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Payment ID (transaction_id) or merchant external_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "019d8619-f711-76b7-b0e1-574328b5baf0"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/payments/{id}/upload_receipt": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Upload UTR / Payment Receipt (H2H)",
        "description": "In server-to-server (`server_mode: true`) mode, confirm a deposit by submitting the UTR (Unique Transaction Reference) and optionally attaching receipt files.",
        "operationId": "uploadPaymentReceipt",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Payment ID (transaction_id) returned from /initiate",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "txn_fin_123456"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "utr"
                ],
                "properties": {
                  "utr": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 22,
                    "description": "Unique Transaction Reference number from the bank",
                    "example": "123456789012"
                  },
                  "file": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 3,
                    "description": "Receipt image files (PNG, JPG, PDF). Optional, max 3 files."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Receipt uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — missing or invalid UTR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/payments/{id}/notify_paid": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Notify Payment Intent (H2H)",
        "description": "Used in H2H mode (`server_mode: true`) to notify that the client has interacted with payment details (e.g., clicked 'Copy' or 'Paid' on merchant's side). This helps track conversion and payment attempts.",
        "operationId": "notifyPaymentPaid",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Internal FinZinc payment identifier (operation_id)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "019dded1-526c-7726-8fa7-1f057bbc9359"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {}
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/payments/initiate": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create Payment",
        "description": "Initiate a new payment transaction (deposit or withdrawal)",
        "operationId": "createPayment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreateDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "external_id": {
                      "type": "string"
                    },
                    "result": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "string"
                    },
                    "requested_sum": {
                      "type": "string"
                    },
                    "currency_code": {
                      "type": "string"
                    },
                    "transfer_details": {
                      "type": "object",
                      "nullable": true
                    },
                    "opened_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/partner/balance": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get Account Balance",
        "description": "Retrieve the current account balance for the authenticated merchant.",
        "operationId": "getAccountBalance",
        "responses": {
          "200": {
            "description": "Account balance retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "balance": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentStatusResponse": {
        "type": "object",
        "required": [
          "operation_id",
          "external_id",
          "result",
          "channel",
          "requested_sum",
          "currency_code",
          "opened_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "external_id": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "awaiting",
              "processing",
              "success",
              "success_partial",
              "success_adjusted",
              "error",
              "failed"
            ]
          },
          "channel": {
            "type": "string"
          },
          "requested_sum": {
            "type": "string"
          },
          "currency_code": {
            "type": "string"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          },
          "client_amount": {
            "type": "string",
            "nullable": true
          },
          "rejection_cause": {
            "type": "string",
            "nullable": true
          },
          "transfer_details": {
            "type": "object",
            "nullable": true
          },
          "settled_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentCreateDTO": {
        "type": "object",
        "required": [
          "sum",
          "status_url",
          "currency_code",
          "external_id",
          "operation",
          "scheme",
          "channel",
          "account_id",
          "redirect_url"
        ],
        "properties": {
          "sum": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "status_url": {
            "type": "string",
            "format": "uri"
          },
          "currency_code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "external_id": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "deposit",
              "withdrawal"
            ]
          },
          "scheme": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "redirect_url": {
            "type": "string",
            "format": "uri"
          },
          "server_mode": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}