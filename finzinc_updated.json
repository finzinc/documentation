                    "summary": "Successful H2H deposit \u2014 transfer_details returned",
                    "value": {
                      "operation_id": "019d862b-7795-7e5b-a8c5-a6494f2f41fe",
                      "channel": "UPI",
                      "redirect_url": null,
                      "external_id": "ext_h2h_001",
                      "result": "awaiting",
                      "client_amount": null,
                      "rejection_cause": null,
                      "requested_sum": "300.00",
                      "currency_code": "INR",
                      "opened_at": "2026-04-13T09:28:08.856Z",
                      "settled_at": null,
                      "transfer_details": {
                        "type": "upi",
                        "upi_account": "hdgsgs261@pty",
                        "qr_code_data": "upi://pay?pa=hdgsgs261@pty&pn=rigarbl&cu=INR&am=300"
                      },
                      "valid_until": null
