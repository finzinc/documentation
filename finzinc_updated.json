        ],
        "summary": "Get Account Balance",
        "description": "Retrieve the current account balance for the authenticated merchant. Balance is determined by the Bearer token \u2014 no account_id required.",
        "operationId": "getAccountBalance",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Account balance retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "balance",
                    "currency"
                  ],
                  "properties": {
                    "balance": {
                      "type": "string",
                      "description": "Current account balance",
                      "example": "-108662.85"
                    },
                    "currency": {
                      "type": "string",
                      "description": "Currency code (ISO 4217)",
                      "example": "INR"
                    }
                  }
                },
                "examples": {
                  "Success": {
                    "value": {
                      "balance": "-108662.85",
                      "currency": "INR"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidAccountId": {
                    "value": {
                      "error": "INVALID_REQUEST",
                      "message": "account_id is required",
                      "timestamp": "2026-03-31T23:48:00Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "error": "UNAUTHORIZED",
                      "message": "Invalid or expired token",
                      "timestamp": "2026-03-31T23:48:00Z"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentStatusResponse": {
        "type": "object",
        "description": "Current state of a payment transaction",
        "required": [
          "transaction_id",
          "external_id",
          "status",
          "operation",
          "sum",
          "currency_code",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "transaction_id": {
            "type": "string",
            "description": "Internal FinZinc payment identifier",
            "example": "txn_fin_123456"
          },
          "external_id": {
            "type": "string",
            "description": "Merchant-provided external identifier",
            "example": "ext_20260331_001"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting",
              "processing",
              "success",
              "success_partial",
              "success_adjusted",
              "error",
              "failed"
            ],
            "description": "Payment status:\n- `pending` \u2014 created, awaiting payer action\n- `processing` \u2014 payment received, being verified\n- `success` \u2014 fully completed (COMPLETED)\n- `success_partial` \u2014 partially completed, funds received but less than requested (PARTIALLY_COMPLETED)\n- `success_adjusted` \u2014 completed with amount correction up or down (ADJUSTING_UP/ADJUSTING_DOWN confirmed)\n- `failed` \u2014 failed, expired, or cancelled",
            "example": "success"
          },
          "operation": {
            "type": "string",
            "enum": [
              "deposit",
              "withdrawal"
            ],
            "description": "Transaction type",
            "example": "deposit"
          },
          "sum": {
            "type": "string",
            "description": "Originally requested payment amount",
            "example": "100.00"
          },
          "sum_processed": {
            "type": "string",
            "description": "Actually processed amount. Present when differs from sum (success_partial or success_adjusted).",
            "example": "150.00"
          },
          "correction": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Direction of amount correction. Present only when status is success_adjusted.",
            "example": "up"
          },
          "currency_code": {
            "type": "string",
            "description": "Currency code (ISO 4217)",
            "example": "INR"
          },
          "channel": {
            "type": "string",
            "description": "Payment channel used",
            "example": "upi"
          },
          "fail_reason": {
            "type": "string",
            "description": "Human-readable failure reason. Present only when status is failed.",
            "example": "Payer did not complete payment within time limit"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Payment creation timestamp",
            "example": "2026-03-31T23:48:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last status update timestamp",
            "example": "2026-03-31T23:51:00Z"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error type: authorization, validation, operation"
          },
          "message": {
            "type": "string",
            "description": "Error message string or validation object with validationErrors array"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the error"
          },
          "details": {
            "type": "array",
            "nullable": true,
            "description": "Validation error details array. Present when type is validation.",
            "items": {
              "type": "object",
              "properties": {
                "property": {
                  "type": "string",
                  "description": "Field name that failed validation"
                },
                "message": {
                  "type": "string",
                  "description": "Validation error message"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "DepositInfoDTO": {
        "type": "object",
        "description": "Deposit credentials",
        "properties": {
          "bank_name": {
            "type": "string",
            "maxLength": 128,
            "description": "Name of the bank"
          },
          "sender_name": {
            "type": "string",
            "maxLength": 128,
            "description": "Full name of the sender/depositor"
          },
          "card_data": {
            "$ref": "#/components/schemas/PaymentCardInfo"
          },
          "vpa": {
            "type": "string",
            "pattern": "^[a-z0-9-_.]{1,128}@[a-z0-9]{1,128}$",
            "description": "VPA (Virtual Payment Address) in format name@bank (e.g., user@okaxis)"
          }
        }
      },
      "WithdrawalInfoDTO": {
        "type": "object",
        "description": "Withdrawal credentials",
        "properties": {
          "bank_name": {
            "type": "string",
            "description": "Name of the beneficiary bank"
          },
          "card_no": {
            "type": "string",
            "description": "Card number for withdrawal (credit/debit card)"
          },
          "beneficiary_name": {
            "type": "string",
            "maxLength": 256,
            "description": "Beneficiary name (required for card, IMPS, or UPI withdrawals)"
          },
          "ifsc_code": {
            "type": "string",
            "pattern": "^[a-z]{4}0[a-z0-9]{6}$",
            "description": "IFSC code in format XXXX0XXXXXX (e.g., HDFC0002060). Required for IMPS withdrawals."
          },
          "bank_account": {
            "type": "string",
            "minLength": 9,
            "maxLength": 32,
            "description": "Beneficiary bank account number"
          },
          "vpa": {
            "type": "string",
            "pattern": "^[a-z0-9-_.]{1,128}@[a-z0-9]{1,128}$",
            "description": "VPA (Virtual Payment Address) in format name@bank (e.g., user@okaxis)"
          },
          "iban_number": {
            "type": "string",
            "description": "International Bank Account Number (IBAN)"
          },
          "tax_reference": {
            "type": "string",
            "description": "Tax reference number"
          }
        }
      },
      "PaymentCardInfo": {
        "type": "object",
        "description": "Payment card information",
        "properties": {
          "card_number": {
            "type": "string",
            "description": "Card number (will be validated as credit card)"
          },
          "expiry_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Card expiry month"
          },
          "expiry_year": {
            "type": "integer",
            "description": "Card expiry year (2-digit or 4-digit)"
          },
          "cvv": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4,
            "description": "Card CVV/CVC code"
          },
          "holder_name": {
            "type": "string",
            "description": "Cardholder name"
          }
        }
      },
      "PaymentCreateDTO": {
        "type": "object",
        "description": "Payment creation request",
        "required": [
          "sum",
          "status_url",
          "currency_code",
          "external_id",
          "operation",
          "scheme",
          "channel",
          "account_id",
          "redirect_url"
        ],
        "properties": {
          "sum": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "description": "Payment amount (decimal format). Minimum amounts: deposit UPI/express_upi/fast_upi \u2014 300; withdrawal UPI \u2014 1000; withdrawal IMPS \u2014 2000.",
            "example": "300.00"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "Callback URL for payment status notifications"
          },
          "currency_code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Currency code (ISO 4217, e.g., USD, EUR, INR)"
          },
          "external_id": {
            "type": "string",
            "minLength": 5,
            "maxLength": 64,
            "description": "Unique transaction identifier from merchant"
          },
          "operation": {
            "type": "string",
            "enum": [
              "deposit",
              "withdrawal"
            ],
            "description": "Transaction type: deposit (collect) or withdrawal (payout)"
          },
          "scheme": {
            "type": "string",
            "enum": [
              "direct",
              "gateway"
            ],
            "description": "Payment scheme type"
          },
          "channel": {
            "type": "string",
            "enum": [
              "upi",
              "upi_intent",
              "imps",
              "fast_upi",
              "express_upi"
            ],
            "description": "Payment channel. Required. Deposit: upi, express_upi (\u2192 UPI_PHONEPE), fast_upi (\u2192 UPI_PAYTM). Withdrawal: upi, imps. Note: upi_intent and imps deposit are not supported."
          },
          "account_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Merchant account identifier"
          },
          "account_name": {
            "type": "string",
            "maxLength": 128,
            "description": "Merchant account name (optional)"
          },
          "redirect_url": {
            "type": "string",
            "format": "uri",
            "description": "Redirect URL after payment completion. Required if server_mode is false and operation is 'deposit'"
          },
          "server_mode": {
            "type": "boolean",
            "description": "Host-to-host mode. When true: redirect_url is not returned, transfer_details contains payment credentials (upi_account, qr_code_data). Required when using H2H integration.",
            "example": true
          },
          "deposit_details": {
            "$ref": "#/components/schemas/DepositInfoDTO"
          },
          "withdrawal_details": {
            "$ref": "#/components/schemas/WithdrawalInfoDTO"
          },
          "traffic_type": {
            "type": "string",
            "description": "Traffic classification (optional)"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token in format: Bearer <token>"
      }
    }
  },
  "tags": [
    {
      "name": "Account",
      "description": "Account and balance operations"
    },
    {
      "name": "Payments",
      "description": "Payment transaction operations (create, confirm, check status)"
    }
  ]
}